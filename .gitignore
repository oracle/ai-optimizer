# spell-checker: disable
##############################################################################
# Project/User Specific
##############################################################################
**/*.log
**/*.zip
**/*.bak
**/*.delete
**/tmp/**
**/temp/**
**/etc/*.json
coverage-*.xml
test-results-*.xml

# ##############################################################################
# # Environment (PyVen, IDE, etc.)
# ##############################################################################
**/.*venv*
**/.vscode
**/.DS_Store
**/*.swp
**/.env
**/*.pem
src/client/app/.streamlit/secrets.toml
src/client/app/.streamlit/dev-oidc-bootstrap.json
src/client/app/.streamlit/dev-oidc-web-client-secret

# ##############################################################################
# # Python
# ##############################################################################
.pytest_cache
.uv-cache
*.py[cod]
*$py.class
**/*.egg-info
**/build/
**/dist/
**/target/
**/.mypy_cache

# Test coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
test-results.xml
**/.ruff_cache
trivy-results.json
trivy-results.sarif

##############################################################################
# AI Code Assists
##############################################################################
**/*[Cc][Ll][Aa][Uu][Dd][Ee]*
**/*[Cc][Ll][Ii][Ne][Ee]*
**/*clinerules*/**
**/*memory-bank*/**

##############################################################################
# Helm
##############################################################################
helm/**/*.tgz
helm/values*.yaml
!helm/values.yaml

##############################################################################
# IaC (also duplicated in opentofu/.gitignore for portability)
##############################################################################
# Ignore variable files (contain credentials)
**/*.tfvars
**/*.tfvars.json
# But allow example variable files for CI/CD testing (safe, no real credentials)
!opentofu/examples/*.tfvars
!opentofu/examples/*.tfvars.json

# OpenTofu state, cache, plans, and local overrides
**/.terraform/
**/.terraform.lock.hcl
**/.terraform.tfstate.lock.info
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfplan.out
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json
**/crash.log
**/crash.*.log

##############################################################################
# Project-specific local paths
##############################################################################
.env.pytest
