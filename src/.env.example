## AI Optimizer starter environment file
## See docs/content/guides/env-vars.mdx for the complete AIO_* variable reference.
## Set the required AI Optimizer application-database values before starting the server directly.
## The local client setup page collects these values when they remain commented.

## Authentication
# AIO_AUTH_MODE=single_user
# AIO_INSTALLATION_ID=
# AIO_ADMIN_DATABASE_USERNAME=
# AIO_AUTH_LOGIN_DATA_ROLE=AIO_LOGIN_ROLE
# AIO_AUTH_SESSION_ABSOLUTE_SECONDS=28800
# AIO_AUTH_SESSION_IDLE_SECONDS=1800
# AIO_AUTH_SESSION_LAST_SEEN_SECONDS=60
# AIO_AUTH_SESSION_MAX_PER_USER=10
# AIO_AUTH_ACCOUNT_STATUS_CACHE_SECONDS=30
# AIO_AUTH_LOGIN_MAX_CONCURRENT=8

## AI Optimizer application database (required)
# AIO_DB_USERNAME=
# AIO_DB_PASSWORD=
# AIO_DB_DSN=localhost:1521/FREEPDB1

## Common model providers
# AIO_OPENAI_API_KEY=
# AIO_ON_PREM_OLLAMA_URL=http://127.0.0.1:11434
